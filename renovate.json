{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "labels": ["github_actions", "dependencies"]
    },
    {
      "matchManagers": ["pip_requirements"],
      "labels": ["python", "dependencies"]
    }
  ]
}
